# Optional. Any BasePaint link Strata emits carries this address as ?referrer=,
# which earns half the protocol fee on mints it refers. No signup, no secret —
# leave it unset and every outbound link still works, just unattributed.
# Copy to .env.local for development, and set it in the Vercel project settings.
VITE_REFERRER_ADDRESS=

# Optional. Where the source lives. The footer links to it when this is set and
# says nothing when it is not — a dead link is worse than no link.
VITE_REPO_URL=

# Optional. Mainnet JSON-RPC, used only to turn addresses into ENS names. Leave
# it unset and Strata falls back to public endpoints; ENS is decoration, and an
# address that will not resolve simply stays an address.
VITE_MAINNET_RPC=
